{
  "name": "dsh-chat-file-actions",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "对话文件操作：查看本轮文件与网页链接，支持打开、定位和复制",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.4" },
  "dependencies": { "@deepseek-ai/schemastery": "~3.18.4" },
  "devDependencies": { "react": "^18.3.1", "react-dom": "^18.3.1", "jsdom": "^27.0.0" },
  "files": ["lib", "locale", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": { "test": "node --test test/*.test.js" }
}
